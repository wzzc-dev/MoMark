import {
  "moonbitlang/core/env",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/macos" @macos_backend,
  "wzzc-dev/moui_wgpu_renderer" @render_wgpu,
  "wzzc-dev/moui_text_providers/coretext" @wgpu_coretext,
  "wzzc-dev/moui_text_providers/cosmic_text" @wgpu_cosmic,
  "wzzc-dev/window/dpi",
  "wzzc-dev/momark",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "" } },
  targets: { "main.mbt": [ "native" ] },
)
